{
  "manifest_version": 3,
  "name": "WhatsApp Privacy Blur",
  "version": "3.0.0",
  "author": "Nyihui",
  "description": "Blur sensitive WhatsApp Web content with hover-to-reveal support for names, photos, messages, and previews.",
  "permissions": [
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "whatsapp-privacy-blur@extension",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "icons/logo-16.png",
    "32": "icons/logo-32.png",
    "48": "icons/logo-48.png",
    "128": "icons/logo-128.png"
  },
  "action": {
    "default_popup": "ui/popup.html",
    "default_icon": "icons/logo-32.png",
    "default_title": "WhatsApp Privacy Blur"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "css": [
        "minimizer/minimizer.css"
      ],
      "js": [
        "selectors/index.js",
        "selectors/avatars.js",
        "selectors/names.js",
        "selectors/text.js",
        "selectors/previews.js",
        "selectors/input.js",
        "selectors/media-preview.js",
        "selectors/media-gallery.js",
        "selectors/misc.js",
        "content.js",
        "ui/styles.js",
        "ui/template.js",
        "ui/panel-controls.js",
        "ui/panel-theme.js",
        "ui/panel-state.js",
        "ui/panel-button.js",
        "ui/panel-main.js",
        "minimizer/minimizer.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/defence_active.png",
        "icons/defence_inactive.png"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ]
    }
  ]
}